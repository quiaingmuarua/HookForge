{
  "mode": "replace",
  "rules": {
    "fileExists": {
      "/data/local/su": false,
      "/data/local/busybox": false,
      "/data/local/magisk": false,
      "/data/local/bin/su": false,
      "/data/local/bin/busybox": false,
      "/data/local/bin/magisk": false,
      "/data/local/xbin/su": false,
      "/data/local/xbin/busybox": false,
      "/data/local/xbin/magisk": false,
      "/sbin/su": false,
      "/sbin/busybox": false,
      "/sbin/magisk": false,
      "/su/bin/su": false,
      "/su/bin/busybox": false,
      "/su/bin/magisk": false,
      "/system/bin/su": false,
      "/system/bin/busybox": false,
      "/system/bin/magisk": false,
      "/system/bin/.ext/su": false,
      "/system/bin/.ext/busybox": false,
      "/system/bin/.ext/magisk": false,
      "/system/bin/failsafe/su": false,
      "/system/bin/failsafe/busybox": false,
      "/system/bin/failsafe/magisk": false,
      "/system/sd/xbin/su": false,
      "/system/sd/xbin/busybox": false,
      "/system/sd/xbin/magisk": false,
      "/system/usr/we-need-root/su": false,
      "/system/usr/we-need-root/busybox": false,
      "/system/usr/we-need-root/magisk": false,
      "/system/xbin/su": false,
      "/system/xbin/busybox": false,
      "/system/xbin/magisk": false,
      "/cache/su": false,
      "/cache/busybox": false,
      "/cache/magisk": false,
      "/data/su": false,
      "/data/busybox": false,
      "/data/magisk": false,
      "/dev/su": false,
      "/dev/busybox": false,
      "/dev/magisk": false
    },
    "nativeFileRedirects": {
      "/data/local/su": "/proc/self/agentforge-missing",
      "/data/local/busybox": "/proc/self/agentforge-missing",
      "/data/local/magisk": "/proc/self/agentforge-missing",
      "/data/local/bin/su": "/proc/self/agentforge-missing",
      "/data/local/bin/busybox": "/proc/self/agentforge-missing",
      "/data/local/bin/magisk": "/proc/self/agentforge-missing",
      "/data/local/xbin/su": "/proc/self/agentforge-missing",
      "/data/local/xbin/busybox": "/proc/self/agentforge-missing",
      "/data/local/xbin/magisk": "/proc/self/agentforge-missing",
      "/sbin/su": "/proc/self/agentforge-missing",
      "/sbin/busybox": "/proc/self/agentforge-missing",
      "/sbin/magisk": "/proc/self/agentforge-missing",
      "/su/bin/su": "/proc/self/agentforge-missing",
      "/su/bin/busybox": "/proc/self/agentforge-missing",
      "/su/bin/magisk": "/proc/self/agentforge-missing",
      "/system/bin/su": "/proc/self/agentforge-missing",
      "/system/bin/busybox": "/proc/self/agentforge-missing",
      "/system/bin/magisk": "/proc/self/agentforge-missing",
      "/system/bin/.ext/su": "/proc/self/agentforge-missing",
      "/system/bin/.ext/busybox": "/proc/self/agentforge-missing",
      "/system/bin/.ext/magisk": "/proc/self/agentforge-missing",
      "/system/bin/failsafe/su": "/proc/self/agentforge-missing",
      "/system/bin/failsafe/busybox": "/proc/self/agentforge-missing",
      "/system/bin/failsafe/magisk": "/proc/self/agentforge-missing",
      "/system/sd/xbin/su": "/proc/self/agentforge-missing",
      "/system/sd/xbin/busybox": "/proc/self/agentforge-missing",
      "/system/sd/xbin/magisk": "/proc/self/agentforge-missing",
      "/system/usr/we-need-root/su": "/proc/self/agentforge-missing",
      "/system/usr/we-need-root/busybox": "/proc/self/agentforge-missing",
      "/system/usr/we-need-root/magisk": "/proc/self/agentforge-missing",
      "/system/xbin/su": "/proc/self/agentforge-missing",
      "/system/xbin/busybox": "/proc/self/agentforge-missing",
      "/system/xbin/magisk": "/proc/self/agentforge-missing",
      "/cache/su": "/proc/self/agentforge-missing",
      "/cache/busybox": "/proc/self/agentforge-missing",
      "/cache/magisk": "/proc/self/agentforge-missing",
      "/data/su": "/proc/self/agentforge-missing",
      "/data/busybox": "/proc/self/agentforge-missing",
      "/data/magisk": "/proc/self/agentforge-missing",
      "/dev/su": "/proc/self/agentforge-missing",
      "/dev/busybox": "/proc/self/agentforge-missing",
      "/dev/magisk": "/proc/self/agentforge-missing"
    },
    "packagesAbsent": [
      "com.noshufou.android.su",
      "com.noshufou.android.su.elite",
      "eu.chainfire.supersu",
      "com.koushikdutta.superuser",
      "com.thirdparty.superuser",
      "com.topjohnwu.magisk",
      "com.devadvance.rootcloak",
      "com.devadvance.rootcloakplus",
      "de.robv.android.xposed.installer",
      "com.saurik.substrate",
      "com.chelpus.lackypatch",
      "com.dimonvideo.luckypatcher"
    ],
    "properties": {
      "ro.debuggable": "0",
      "ro.secure": "1",
      "ro.build.selinux": "0",
      "service.adb.root": "0"
    },
    "buildTags": "release-keys",
    "readOnlyMounts": [
      "/system",
      "/system/bin",
      "/system/sbin",
      "/system/xbin",
      "/vendor/bin",
      "/sbin",
      "/etc"
    ],
    "commandRedirects": [
      {
        "argv": [
          "which",
          "su"
        ],
        "replacement": [
          "which",
          "agentforge-missing-command"
        ]
      }
    ]
  }
}
