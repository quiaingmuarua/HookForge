{
  "name": "hookforge",
  "version": "1.0.0",
  "description": "Practical Frida hooks and real-app dynamic analysis",
  "private": true,
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "postinstall": "node scripts/patch-java-bridge.mjs",
    "build": "npm run build:hosts && npm run build:bundle",
    "build:bundle": "node esbuild.config.mjs",
    "build:api": "node scripts/build-api-agent.mjs",
    "build:hosts": "node scripts/build-hosts.mjs",
    "build:prod": "npm run check:bridge-patch && cross-env NODE_ENV=production npm run build:hosts && cross-env NODE_ENV=production npm run build:bundle && cross-env NODE_ENV=production npm run build:api",
    "build:dev": "cross-env NODE_ENV=development npm run build:hosts && cross-env NODE_ENV=development npm run build:bundle",
    "build:watch": "npm run build:hosts && node esbuild.config.mjs --watch",
    "dev": "npm run build:dev && npm run inject:test",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test:unit": "node --import tsx/esm --test test/unit/*.test.ts cases/rootbeer/*.test.mjs cases/duck-system-properties/*.test.mjs cases/duck-build-profile/*.test.mjs cases/reveny-system-properties/*.test.mjs",
    "case:rootbeer": "node cases/rootbeer/run.mjs",
    "case:duck-system-properties": "node cases/duck-system-properties/run.mjs",
    "test:ci": "npm run type-check && npm run type-check:tests && npm run type-check:agents && npm run lint && npm run test:unit && npm run test:tools && npm run check:hosts && npm run build:dev",
    "lint": "eslint \"packages/**/*.ts\" \"configs/**/*.ts\" \"hosts/**/*.ts\" \"scripts/*.mjs\" \"cases/rootbeer/*.{ts,mjs}\" \"cases/duck-system-properties/*.{ts,mjs}\" \"test/unit/**/*.ts\" \"test/api33/*.ts\" \"test/api33/native.js\" \"apps/**/*.{ts,mjs}\" \"cases/composable/*.{ts,mjs}\" \"cases/duck-build-profile/*.{ts,mjs}\" \"cases/reveny-system-properties/*.{ts,mjs}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "inject:test": "node hosts/node-cli/run.js com.android.calculator2",
    "inject:spawn": "node hosts/node-cli/run.js -s com.android.calculator2",
    "inject:verbose": "node hosts/node-cli/run.js -v com.android.calculator2",
    "test:messages": "node scripts/test-apps.js messages -s",
    "test:telegram": "node scripts/test-apps.js telegram -s",
    "test:wechat": "node scripts/test-apps.js wechat -s",
    "test:chrome": "node scripts/test-apps.js chrome -s",
    "test:calculator": "node scripts/test-apps.js calculator -s",
    "test:settings": "node scripts/test-apps.js settings -s",
    "test:detectapp": "node scripts/test-apps.js detectapp -s",
    "test:device:detectapp": "node scripts/test-apps.js detectapp -s",
    "test:node:smoke:settings:spawn": "node hosts/node-cli/run.js --smoke --timeout-ms 8000 -c configs/targets/default.json -s com.android.settings",
    "test:node:smoke:settings:frontmost": "node scripts/test-apps.js settings --frontmost --smoke --timeout-ms 8000",
    "observe:android": "node hosts/node-cli/run.js -c configs/targets/api-observe.json",
    "test:node:smoke:detectapp:frontmost": "node scripts/test-apps.js detectapp --frontmost --smoke --timeout-ms 8000",
    "test:node:probe:java": "node scripts/node-java-probe.js com.android.settings",
    "parse:sample:external": "node hosts/node-cli/parse-log.js samples/external/frida-trace-sample.log",
    "import:sample:frida-trace": "node scripts/import/import-frida-trace.js samples/external/frida-trace-sample.log",
    "import:sample:community": "node scripts/import/import-community-log.js samples/external/frida-trace-sample.log",
    "recipe:network-observe": "node hosts/node-cli/run-recipe.js configs/runs/network-observe.json",
    "recipe:root-detect": "node hosts/node-cli/run-recipe.js configs/runs/root-detect.json",
    "test:smoke:messages": "frida -q -Uf com.google.android.apps.messaging -l .\\test\\simple_smoke.js",
    "test:smoke:settings": "frida -q -Uf com.android.settings -l .\\test\\simple_smoke.js",
    "test:smoke:detectapp": "frida -q -UF com.detect.app.sample -l .\\test\\detectapp_attach_smoke.js",
    "test:smoke:detectapp:passive": "frida -q -UF com.detect.app.sample -l .\\test\\detectapp_passive_smoke.js",
    "fingerprint": "node scripts/fingerprint.js",
    "fingerprint:manual": "node scripts/fingerprint.js manual",
    "spoof:demo": "node scripts/spoof-validation-demo.js",
    "spoof:validate": "node scripts/spoof-validation-demo.js -v",
    "validate:spoof": "node scripts/validate-spoof.js",
    "validate:auto": "node scripts/validate-spoof.js -s -v",
    "validate:ts": "npx ts-node scripts/validate-spoof-ts.ts",
    "validate:rpc": "npx ts-node scripts/validate-spoof-ts.ts",
    "validate:simple": "node scripts/simple-validation.js",
    "validate:final": "node scripts/validate-rpc-final.js",
    "hook:messages": "node scripts/test-apps.js messages",
    "hook:telegram": "node scripts/test-apps.js telegram",
    "hook:wechat": "node scripts/test-apps.js wechat",
    "quick": "node scripts/quick-test.js",
    "apps": "node scripts/test-apps.js",
    "run:usb": "node hosts/node-cli/run.js",
    "stats": "node scripts/stats.mjs",
    "check:hosts": "node scripts/build-hosts.mjs --check",
    "type-check:tests": "tsc --project tsconfig.test.json --noEmit",
    "type-check:agents": "tsc --project tsconfig.agent.json --noEmit",
    "test:tools": "node scripts/test-api33-tools.mjs",
    "artifact:write": "cross-env NODE_ENV=production node scripts/production-artifact.mjs write",
    "artifact:verify": "node scripts/production-artifact.mjs verify",
    "check:bridge-patch": "node scripts/patch-java-bridge.mjs --check",
    "cli": "node hosts/node-cli/run.js",
    "case:composable": "node cases/composable/run.mjs",
    "case:duck-build-profile": "node cases/duck-build-profile/run.mjs",
    "case:reveny-system-properties": "node cases/reveny-system-properties/run.mjs"
  },
  "keywords": [
    "frida",
    "reverse-engineering",
    "android",
    "ios",
    "hooking",
    "modular"
  ],
  "license": "MIT",
  "dependencies": {
    "frida": "^17.4.0",
    "frida-java-bridge": "7.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.9",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "bin": {
    "af-frida": "hosts/node-cli/run.js"
  }
}
